# Shared Docker Compose configuration for local development only.
TZ=America/Monterrey

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_USER=misvales_admin
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_ADMIN_PASSWORD
POSTGRES_DB=postgres
POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=C.UTF-8
MISVALES_DEV_DB=misvales_dev
MISVALES_DEV_USER=misvales_dev_user
MISVALES_DEV_PASSWORD=CHANGE_ME_POSTGRES_DEV_PASSWORD
MISVALES_TEST_DB=misvales_test
MISVALES_TEST_USER=misvales_test_user
MISVALES_TEST_PASSWORD=CHANGE_ME_POSTGRES_TEST_PASSWORD

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=misvales_local_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_APP_ACCESS_KEY=misvales_local_app
MINIO_APP_SECRET_KEY=CHANGE_ME_MINIO_APP_SECRET_KEY
MINIO_PRIVATE_BUCKET=misvales-private
MINIO_BACKUPS_BUCKET=misvales-backups
MINIO_REGION=us-east-1

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
MP_DATABASE=/data/mailpit.db
MP_SMTP_BIND_ADDR=0.0.0.0:1025
MP_UI_BIND_ADDR=0.0.0.0:8025

# pgAdmin (profile: tools)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@misvales.local
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD
PGADMIN_CONFIG_SERVER_MODE=False
PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED=False

# RedisInsight (profile: tools)
REDISINSIGHT_PORT=5540
RI_ACCEPT_TERMS_AND_CONDITIONS=true

# Observability (profile: observability)
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
GF_SECURITY_ADMIN_USER=misvales_admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
