# Host ports for the S3 API and administrative console.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Administrative credentials used only for local MinIO maintenance.
MINIO_ROOT_USER=misvales_local_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD

# Restricted application credentials used by Laravel.
MINIO_APP_ACCESS_KEY=misvales_local_app
MINIO_APP_SECRET_KEY=CHANGE_ME_MINIO_APP_SECRET_KEY

# Private buckets managed by the one-shot initializer.
MINIO_PRIVATE_BUCKET=misvales-private
MINIO_BACKUPS_BUCKET=misvales-backups
MINIO_REGION=us-east-1
TZ=America/Monterrey
