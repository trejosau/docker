# PostgreSQL 17 local development settings. Replace every CHANGE_ME value.
POSTGRES_PORT=5432
POSTGRES_USER=misvales_admin
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_ADMIN_PASSWORD
POSTGRES_DB=postgres
POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=C.UTF-8

# Dedicated development database and non-administrative owner.
MISVALES_DEV_DB=misvales_dev
MISVALES_DEV_USER=misvales_dev_user
MISVALES_DEV_PASSWORD=CHANGE_ME_POSTGRES_DEV_PASSWORD

# Dedicated automated-test database and non-administrative owner.
MISVALES_TEST_DB=misvales_test
MISVALES_TEST_USER=misvales_test_user
MISVALES_TEST_PASSWORD=CHANGE_ME_POSTGRES_TEST_PASSWORD

# Container clock; each application database is explicitly configured to UTC.
TZ=America/Monterrey
