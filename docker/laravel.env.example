# Copy the relevant values manually into Laravel's existing .env file.
# Replace blank passwords/access keys with values from docker/env/*.env.

APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4200

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=misvales_dev
DB_USERNAME=misvales_dev_user
DB_PASSWORD=

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=misvales_dev_

# Suggested logical prefixes when the Laravel configuration supports them.
CACHE_PREFIX=misvales_dev_cache_
SESSION_COOKIE=misvales_dev_session
QUEUE_PREFIX=misvales_dev_queue_
RATE_LIMITER_PREFIX=misvales_dev_rate_limit_
LOCK_PREFIX=misvales_dev_lock_

FILESYSTEM_DISK=s3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=misvales-private
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@misvales.local
MAIL_FROM_NAME="${APP_NAME}"

# Testing database. Wire these into phpunit.xml or the project's test bootstrap.
DB_TEST_HOST=127.0.0.1
DB_TEST_PORT=5432
DB_TEST_DATABASE=misvales_test
DB_TEST_USERNAME=misvales_test_user
DB_TEST_PASSWORD=

# Tests should use isolated logical Redis databases/prefixes.
REDIS_TEST_DB=2
REDIS_TEST_CACHE_DB=3
REDIS_TEST_PREFIX=misvales_test_

# Optional OpenTelemetry endpoint after starting the observability profile.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=misvales-backend-local
